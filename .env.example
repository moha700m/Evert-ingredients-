# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
WEBHOOK_SECRET=change-this-to-a-long-random-secret
SETUP_SECRET=change-this-to-another-long-random-secret
PUBLIC_BASE_URL=

# ===== Canboso / CipherForge buyer API =====
CANBOSO_API_KEY=
CANBOSO_BASE_URL=https://canboso.com
CANBOSO_PRODUCTS_PATH=/api/v2/telegram-buyer/products
CANBOSO_PURCHASE_PATH=/api/v2/telegram-buyer/purchase

# Optional auth override. Official buyer routes use buyer key/query/body; keep blank unless provider changes.
CANBOSO_AUTH_HEADER=
CANBOSO_AUTH_PREFIX=

PRODUCT_ID_KEYS=productId,id,product_id,uuid,sku
PRODUCT_NAME_KEYS=name,title,product_name
PRODUCT_DESC_KEYS=description,desc,details
PRODUCT_PRICE_KEYS=price,amount,cost

# Official purchase payload. Email-only products add customer_email automatically, with quantity=1.
# Other slot/upgrade requirements remain visible and require manual execution.
# Supported placeholders: {{buyer_key}}, {{product_id}}, {{telegram_user_id}}, {{telegram_username}}
PURCHASE_BODY_TEMPLATE={"key":"{{buyer_key}}","product_id":"{{product_id}}","quantity":1}

# Stars charged per supplier USD before markup. Example: 100 means $1 supplier cost => 100 Stars before markup.
STAR_RATE=100
MARKUP_PERCENT=25
PRODUCTS_PAGE_SIZE=8
ENABLE_LIVE_PURCHASES=false
AR_OVERRIDES_JSON={}
